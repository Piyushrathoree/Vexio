# Database — app runtime uses the pooled Neon URL; Prisma migrations use DIRECT_URL.
DATABASE_URL=
DIRECT_URL=
# Better Auth (http-server)
BETTER_AUTH_SECRET=""   # min 32 chars — run: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:8000"
WEB_URL="http://localhost:3001"
# Prod only: set to a shared parent domain (e.g. ".vexio.com") so the session
# cookie is visible to the web app's middleware across subdomains. Leave unset
# for local dev (web + API both on localhost).
COOKIE_DOMAIN=""
# Prod only, alternative to COOKIE_DOMAIN: web app and API on unrelated sites
# (e.g. *.vercel.app + *.onrender.com). Makes session cookies SameSite=None so
# cross-site fetches carry them. Leave unset for local dev.
CROSS_SITE_AUTH=""

# Frontend (web app)
NEXT_PUBLIC_AUTH_URL="http://localhost:8000"
NEXT_PUBLIC_WS_URL="ws://localhost:8080"

# WebSocket server
WS_PORT="8080"

# OAuth — create apps at Google Cloud Console & GitHub Developer Settings
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Server
PORT="8000"
WS_PORT="8080"

# Email (verification + password reset) — sent through Gmail via Nodemailer.
# Use a Google App Password, not your regular Gmail password:
# https://support.google.com/accounts/answer/185833
SMTP_USER="your@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM="Vexio <your@gmail.com>"

# AI icon generation (http-server) — see docs/guides/AI_ICON_GENERATION.md
ANTHROPIC_API_KEY=""
